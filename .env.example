# Backend Environment Variables
# Copy to .env and configure with your values

# MongoDB connection string
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=jarvis_db

# Groq LLM Configuration (Required for Agent Execution)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# CORS allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Reports storage directory
REPORTS_DIR=./reports

# Google Integrations (Drive & Gmail OAuth 2.0)
# 1. Enable Google Drive API & Gmail API in Google Cloud Console
# 2. Configure OAuth Consent Screen with scopes:
#    - https://www.googleapis.com/auth/gmail.readonly (Search & read emails)
#    - https://www.googleapis.com/auth/gmail.compose  (Create safe drafts for review)
#    - https://www.googleapis.com/auth/drive.file     (Upload reports)
#    - https://www.googleapis.com/auth/drive.readonly (Read Drive files)
# 3. Create OAuth 2.0 Client ID (Web Application) with redirect URI below
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Playwright Browser Automation & Web Search
ENABLE_BROWSER_AUTOMATION=true
BROWSER_HEADLESS=true

# Search Provider: 'duckduckgo' (built-in, no key required), 'tavily', or 'serper'
SEARCH_PROVIDER=duckduckgo
# Optional search API keys (leave blank to use built-in DuckDuckGo search)
TAVILY_API_KEY=
SERPER_API_KEY=
